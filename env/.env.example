# =============================================================
# AtendaHub ISP — variáveis de ambiente para o pacote standalone
#
# Copie para .env e preencha antes de executar install.sh.
# =============================================================

# Identificador das imagens (em modo offline, fixadas pelo install.sh após
# o docker load; em modo registry, ajuste para o repositório/tag correto).
FRONTEND_ISP_IMAGE=atendahub/frontend-isp:latest
BACKEND_GO_IMAGE=atendahub/backend-go:latest
WHATSMEOW_WORKER_IMAGE=atendahub/whatsmeow-worker:latest

TZ=America/Sao_Paulo

# ---------------- URLs externas (HTTPS) ----------------
# Use os domínios finais do cliente. Sem barra no fim.
PUBLIC_URL=https://api.exemplo.com
FRONTEND_URL=https://app.exemplo.com

# ---------------- PostgreSQL ----------------
DB_NAME=atendahub
DB_USER=atendahub
DB_PASS=troque-esta-senha-db

# ---------------- Redis / RabbitMQ ----------------
RABBITMQ_USER=atendahub
RABBITMQ_PASS=troque-esta-senha-rabbit

# ---------------- JWT ----------------
# Pode usar o mesmo valor para JWT_SECRET e WHATSMEOW_JWT_SECRET, mas
# recomenda-se manter diferentes.
JWT_SECRET=troque-este-jwt-secret-principal
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

# ---------------- WhatsMeow worker ----------------
WHATSMEOW_DATABASE=atendahub_whatsmeow
WHATSMEOW_JWT_SECRET=troque-este-jwt-secret-whatsmeow
WHATSMEOW_API_TOKEN=troque-este-token-whatsmeow
WHATSMEOW_DISABLE_HISTORY_SYNC=false
WHATSMEOW_DEVICE_NAME=AtendaHub
WHATSAPP_LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=52428800

# ---------------- Meta Cloud API (opcional) ----------------
META_GRAPH_URL=https://graph.facebook.com/v24.0
META_VERIFY_TOKEN=
META_APP_SECRET=

# ---------------- IA compatível OpenAI (opcional) ----------------
AI_API_URL=
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.3
